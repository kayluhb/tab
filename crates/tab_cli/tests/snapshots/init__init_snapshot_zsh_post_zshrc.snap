---
source: crates/tab_cli/tests/init.rs
expression: init
---
TAB_SHELL='/bin/zsh'
if [[ -n "${ZSH_NAME:-}" ]]; then

# add ~/.local/bin to PATH
if [[ -d "${HOME}/.local/bin" ]] && [[ ":$PATH:" != *":${HOME}/.local/bin:"* ]]; then
  PATH="${PATH:+"$PATH:"}${HOME}/.local/bin"
fi

if [[ -z "${TTY:-}" ]]; then
  TTY=$(tty)
fi
export TTY

export SHELL_PID="$$"

if [[ -z "${TAB_SHELL:-}" ]]; then
  TAB_SHELL=$(tab _ get-shell)
fi

# shellcheck disable=SC2059
function fig_osc { printf "\033]697;$1\007" "${@:2}"; }

TAB_HAS_SET_PROMPT=0

fig_preexec() {
  # No-PTY mode never wraps the prompt, and no PTY reads the markers
  _tab_link_active && return

  # Restore user defined prompt before executing.
  if [ -n "${PS1+x}" ]; then
    PS1="$TAB_USER_PS1"
  fi
  if [ -n "${PROMPT+x}" ]; then
    PROMPT="$TAB_USER_PROMPT"
  fi
  if [ -n "${prompt+x}" ]; then
    prompt="$TAB_USER_prompt"
  fi

  if [ -n "${PS2+x}" ]; then
    PS2="$TAB_USER_PS2"
  fi
  if [ -n "${PROMPT2+x}" ]; then
    PROMPT2="$TAB_USER_PROMPT2"
  fi

  if [ -n "${PS3+x}" ]; then
    PS3="$TAB_USER_PS3"
  fi
  if [ -n "${PROMPT3+x}" ]; then
    PROMPT3="$TAB_USER_PROMPT3"
  fi

  if [ -n "${PS4+x}" ]; then
    PS4="$TAB_USER_PS4"
  fi
  if [ -n "${PROMPT4+x}" ]; then
    PROMPT4="$TAB_USER_PROMPT4"
  fi

  if [ -n "${RPS1+x}" ]; then
    RPS1="$TAB_USER_RPS1"
  fi
  if [ -n "${RPROMPT+x}" ]; then
    RPROMPT="$TAB_USER_RPROMPT"
  fi

  if [ -n "${RPS2+x}" ]; then
    RPS2="$TAB_USER_RPS2"
  fi
  if [ -n "${RPROMPT2+x}" ]; then
    RPROMPT2="$TAB_USER_RPROMPT2"
  fi

  TAB_HAS_SET_PROMPT=0

  fig_osc "OSCLock=%s" "${TABTERM_SESSION_ID}"
  fig_osc PreExec
}

fig_precmd() {
  local LAST_STATUS=$?

  fig_reset_hooks
  _tab_link_prompt "$LAST_STATUS"
  # No-PTY mode: the link socket already has the prompt, cwd, exit code, env
  # and aliases. The OSC markers and prompt wrapping below are only read by the
  # PTY tabterm.
  _tab_link_active && return

  fig_osc "OSCUnlock=%s" "${TABTERM_SESSION_ID}"
  fig_osc "Dir=%s" "$PWD"
  fig_osc "Shell=zsh"
  fig_osc "ShellPath=%s" "${TAB_SHELL:-$SHELL}"
  if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    fig_osc "WSLDistro=%s" "${WSL_DISTRO_NAME}"
  fi
  fig_osc "PID=%d" "$$"
  fig_osc "ExitCode=%s" "${LAST_STATUS}"
  fig_osc "TTY=%s" "${TTY}"
  fig_osc "Log=%s" "${TAB_LOG_LEVEL}"
  fig_osc "ZshAutosuggestionColor=%s" "${ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE}"
  fig_osc "FigAutosuggestionColor=%s" "${TAB_AUTOSUGGEST_HIGHLIGHT_STYLE}"
  fig_osc "User=%s" "${USER:-root}"

  if [ "$TAB_HAS_SET_PROMPT" -eq 1 ]; then
    # ^C pressed while entering command, call preexec manually to clear fig prompts.
    fig_preexec
  fi

  START_PROMPT=$'\033]697;StartPrompt\007'
  END_PROMPT=$'\033]697;EndPrompt\007'
  NEW_CMD=$'\033]697;NewCmd='"${TABTERM_SESSION_ID}"$'\007'

  # Save user defined prompts.
  TAB_USER_PS1="$PS1"
  TAB_USER_PROMPT="$PROMPT"
  TAB_USER_prompt="$prompt"

  TAB_USER_PS2="$PS2"
  TAB_USER_PROMPT2="$PROMPT2"

  TAB_USER_PS3="$PS3"
  TAB_USER_PROMPT3="$PROMPT3"

  TAB_USER_PS4="$PS4"
  TAB_USER_PROMPT4="$PROMPT4"

  TAB_USER_RPS1="$RPS1"
  TAB_USER_RPROMPT="$RPROMPT"

  TAB_USER_RPS2="$RPS2"
  TAB_USER_RPROMPT2="$RPROMPT2"

  if [ -n "${PROMPT+x}" ]; then
    PROMPT="%{$START_PROMPT%}$PROMPT%{$END_PROMPT$NEW_CMD%}"
  elif [ -n "${prompt+x}" ]; then
    prompt="%{$START_PROMPT%}$prompt%{$END_PROMPT$NEW_CMD%}"
  else
    PS1="%{$START_PROMPT%}$PS1%{$END_PROMPT$NEW_CMD%}"
  fi

  if [ -n "${PROMPT2+x}" ]; then
    PROMPT2="%{$START_PROMPT%}$PROMPT2%{$END_PROMPT%}"
  else
    PS2="%{$START_PROMPT%}$PS2%{$END_PROMPT%}"
  fi

  if [ -n "${PROMPT3+x}" ]; then
    PROMPT3="%{$START_PROMPT%}$PROMPT3%{$END_PROMPT$NEW_CMD%}"
  else
    PS3="%{$START_PROMPT%}$PS3%{$END_PROMPT$NEW_CMD%}"
  fi

  if [ -n "${PROMPT4+x}" ]; then
    PROMPT4="%{$START_PROMPT%}$PROMPT4%{$END_PROMPT%}"
  else
    PS4="%{$START_PROMPT%}$PS4%{$END_PROMPT%}"
  fi

  # Previously, the af-magic theme added a final % to expand. We need to paste without the %
  # to avoid doubling up and mangling the prompt. I've removed this workaround for now.
  if [ -n "${RPROMPT+x}" ]; then
    RPROMPT="%{$START_PROMPT%}$RPROMPT%{$END_PROMPT%}"
  else
    RPS1="%{$START_PROMPT%}$RPS1%{$END_PROMPT%}"
  fi

  if [ -n "${RPROMPT2+x}" ]; then
    RPROMPT2="%{$START_PROMPT%}$RPROMPT2%{$END_PROMPT%}"
  else
    RPS2="%{$START_PROMPT%}$RPS2%{$END_PROMPT%}"
  fi

  TAB_HAS_SET_PROMPT=1

  if command -v tab >/dev/null 2>&1; then
    (command tab _ pre-cmd --alias "$(\alias)" > /dev/null 2>&1 &) >/dev/null 2>&1
  fi
}

fig_reset_hooks() {
  # shellcheck disable=SC1087,SC2193
  if [[ "$precmd_functions[-1]" != fig_precmd ]]; then
    # shellcheck disable=SC2206,SC2296
    precmd_functions=(${(@)precmd_functions:#fig_precmd} fig_precmd)
  fi
  # shellcheck disable=SC1087,SC2193
  if [[ "$preexec_functions[1]" != fig_preexec ]]; then
    # shellcheck disable=SC2206,SC2296
    preexec_functions=(fig_preexec ${(@)preexec_functions:#fig_preexec})
  fi
}

fig_reset_hooks
if [[ -n "${PROCESS_LAUNCHED_BY_TAB:-}" ]]; then
  fig_osc DoneSourcing
fi

fi

# no_pty.zsh, which defines _tab_link_active, is sourced after this file
if [[ "${TABTERM_MODE:-}" != no-pty ]]; then
  (command tab _ pre-cmd --alias "$(\alias)" > /dev/null 2>&1 &) >/dev/null 2>&1
fi
# zsh-only code, which shellcheck reads as bash: expansion flags, assoc array literals
# shellcheck disable=SC2034,SC2066,SC2190,SC2296,SC2298
if [[ -n "${ZSH_NAME:-}" ]]; then

# No-PTY mode: tabterm runs in the background and zsh reports to it over a
# socket, so nothing sits between the terminal and the shell. pre.sh starts it
# and sets TABTERM_MODE=no-pty and TABTERM_LINK_SOCKET. The protocol is in
# crates/tabterm/src/no_pty/protocol.rs. Lines with text are read with `IFS=`,
# or read would strip spaces at the ends of the text.

# The connection state. Kept if this file is sourced again (e.g. `source
# ~/.zshrc`), so the shell keeps its connection instead of opening a second one.
# Set only on the first source, which a function marks: the environment cannot
# hold a function, so a value imported from the environment is never used.
if (( ! ${+functions[_tab_link_connect]} )); then
  typeset -g _tab_link_fd="" _tab_link_push_fd="" _tab_link_sent=""
  typeset -g _tab_link_env_sent="" _tab_link_alias_sent="" _tab_link_focus_on=""
  # Counts buffer reports; tabterm tags each insert with the one it was computed from
  typeset -gi _tab_link_seq=0
fi
# _tab_link_key_name: key sequence -> the name tabterm knows the key by.
# _tab_link_fallback: keymap:sequence -> the widget the key had before tabterm
# bound it ('' where that keymap is the same as main). _tab_link_bound: the
# names bound now.
typeset -gA _tab_link_fallback _tab_link_key_name _tab_link_bound

_tab_link_active() {
  [[ "${TABTERM_MODE:-}" == no-pty && -n "${TABTERM_LINK_SOCKET:-}" ]]
}

# Escapes a value for the protocol into REPLY
_tab_link_escape() {
  REPLY=${1//\\/\\\\}
  REPLY=${REPLY//$'\n'/\\n}
  REPLY=${REPLY//$'\t'/\\t}
}

_tab_link_disconnect() {
  if [[ -n "$_tab_link_push_fd" ]]; then
    zle -F "$_tab_link_push_fd" 2>/dev/null
    exec {_tab_link_push_fd}>&-
  fi
  [[ -n "$_tab_link_fd" ]] && exec {_tab_link_fd}>&-
  _tab_link_fd="" _tab_link_push_fd="" _tab_link_sent=""
  _tab_link_env_sent="" _tab_link_alias_sent=""
  _tab_link_ghost_buffer="" _tab_link_ghost_suffix=""
  # Give the popup's keys back: no `bind` line can release them now. tabterm
  # sends the full set again on the next connection.
  (( ${#_tab_link_bound} )) && _tab_link_bind
  return 0
}

_tab_link_connect() {
  [[ -n "$_tab_link_fd" ]] && return 0
  _tab_link_active || return 1
  # Only a socket this user owns: tabterm made it in a private folder
  [[ -S "$TABTERM_LINK_SOCKET" && -O "$TABTERM_LINK_SOCKET" ]] || return 1
  zmodload zsh/net/socket zsh/zselect 2>/dev/null || return 1

  zsocket "$TABTERM_LINK_SOCKET" 2>/dev/null || return 1
  _tab_link_fd=$REPLY
  if zsocket "$TABTERM_LINK_SOCKET" 2>/dev/null; then
    _tab_link_push_fd=$REPLY
    print -r -u "$_tab_link_push_fd" -- push
    zle -F "$_tab_link_push_fd" _tab_link_on_push 2>/dev/null
  fi

  _tab_link_escape "${TTY:-}"
  local tty=$REPLY
  _tab_link_escape "${TAB_SHELL:-$SHELL}"
  _tab_link_send "hello"$'\t'"$$"$'\t'"$tty"$'\t'"$REPLY"
}

# Sends one line; drops the connection if tabterm is gone. Never blocks the
# shell if tabterm stopped reading: zselect -w only promises room for the
# socket's low-water mark (2 KB), so the line goes in chunks of at most that,
# checking each time. A line that cannot start is dropped; one cut off partway
# drops the connection, as the rest of the protocol would be out of step.
_tab_link_send() {
  [[ -n "$_tab_link_fd" ]] || return 1
  local line=$1$'\n'
  local -a ready
  local -i i
  # 512 characters is at most 2 KB of UTF-8
  for (( i = 1; i <= ${#line}; i += 512 )); do
    if ! zselect -t 0 -a ready -w "$_tab_link_fd" 2>/dev/null; then
      (( i > 1 )) && _tab_link_disconnect
      return 1
    fi
    if ! print -rn -u "$_tab_link_fd" -- "${line[i,i+511]}" 2>/dev/null; then
      _tab_link_disconnect
      return 1
    fi
  done
}

# Text the next line should start with (e.g. a shell started with initial text).
# precmd cannot edit the line, so zle-line-init applies it.
typeset -g _tab_link_start_text="" _tab_link_start_run=""

# Sends the exported environment and the aliases, each only when it changed
# since it was last sent. Built in the shell, with no process or subshell.
_tab_link_send_context() {
  local key line="env"
  for key in ${(ko)parameters[(R)*export*]}; do
    _tab_link_escape "$key"
    line+=$'\t'"$REPLY"
    _tab_link_escape "${(P)key}"
    line+=$'\t'"$REPLY"
  done
  if [[ "$line" != "$_tab_link_env_sent" ]] && _tab_link_send "$line"; then
    _tab_link_env_sent=$line
  fi

  # The same `name=value` lines `alias` prints
  local -a lines
  for key in ${(ko)aliases}; do
    lines+=("$key=${(q-)aliases[$key]}")
  done
  for key in ${(ko)galiases}; do
    lines+=("$key=${(q-)galiases[$key]}")
  done
  _tab_link_escape "${(pj:\n:)lines}"
  line="alias"$'\t'"$REPLY"
  if [[ "$line" != "$_tab_link_alias_sent" ]] && _tab_link_send "$line"; then
    _tab_link_alias_sent=$line
  fi
}

_tab_link_prompt() {
  _tab_link_connect || return
  _tab_link_send_context
  _tab_link_escape "$PWD"
  _tab_link_send "prompt"$'\t'"$1"$'\t'"$REPLY" || return
  _tab_link_sent=""
  # Ask the terminal to report focus changes while at the prompt, so switching
  # tabs or windows can hide the popup
  print -n $'\e[?1004h'
  _tab_link_focus_on=1
  local reply
  IFS= read -r -u "$_tab_link_fd" -t 0.2 reply 2>/dev/null || return
  _tab_link_parse_set "$reply" || return
  _tab_link_start_text=$REPLY _tab_link_start_run=$_tab_link_set_execute
}

_tab_link_line_init() {
  [[ -n "$_tab_link_start_text" ]] || return
  BUFFER=$_tab_link_start_text
  CURSOR=${#BUFFER}
  _tab_link_start_text=""
  [[ "$_tab_link_start_run" == 1 ]] && zle accept-line
}

# Stops focus reporting, so commands never see the focus sequences
_tab_link_focus_off() {
  [[ -n "$_tab_link_focus_on" ]] || return
  print -n $'\e[?1004l'
  _tab_link_focus_on=""
}

# Hides the popup. The line stays reported as is, so the redraw after this
# widget does not show it again; the next edit does.
_tab_link_focus_out() {
  _tab_link_send "focus"$'\t'"0"
}

_tab_link_focus_in() {
  _tab_link_send "focus"$'\t'"1"
}

_tab_link_preexec() {
  _tab_link_focus_off
  [[ -n "$_tab_link_fd" ]] || return
  _tab_link_escape "$1"
  _tab_link_send "preexec"$'\t'"$REPLY"
}

# Reports the buffer on every redraw that changed it, while editing a command
# line: not in vared or other zle contexts. ^R search runs no redraw hook, so
# the line is reported once the search ends.
_tab_link_report() {
  [[ -n "$_tab_link_fd" ]] && [[ "$CONTEXT" == start || "$CONTEXT" == cont ]] || return
  local state="$CURSOR"$'\t'"$BUFFER"
  [[ "$state" == "$_tab_link_sent" ]] && return
  (( ++_tab_link_seq ))
  _tab_link_escape "$BUFFER"
  # A dropped report is sent again on the next redraw
  _tab_link_send "buffer"$'\t'"$_tab_link_seq"$'\t'"$CURSOR"$'\t'"$REPLY" && _tab_link_sent=$state
}

# Bound to the keys the popup uses. Asks tabterm whether the popup takes the
# key; if not, runs whatever the key did before.
_tab_link_key() {
  local name=${_tab_link_key_name[$KEYS]} reply=""
  # Drop an answer that arrived after an earlier query gave up waiting
  [[ -n "$_tab_link_fd" ]] && while read -r -u "$_tab_link_fd" -t 0 reply 2>/dev/null; do :; done
  reply=""
  if [[ -n "$name" && -n "$_tab_link_fd" ]] && _tab_link_send "key"$'\t'"$name"; then
    read -r -u "$_tab_link_fd" -t 0.1 reply 2>/dev/null
  fi
  case "$reply" in
    $'key\t1\t1')
      # Apply the insert here: only a widget can run the line. Ghost text or
      # keys to bind may arrive before it on the same connection.
      local line
      while [[ -n "$_tab_link_push_fd" ]] && IFS= read -r -u "$_tab_link_push_fd" -t 0.2 line 2>/dev/null; do
        _tab_link_handle_push "$line" && continue
        _tab_link_apply "$line" && zle accept-line
        break
      done
      return ;;
    $'key\t1\t0') return ;;
  esac

  local fallback=${_tab_link_fallback[$KEYMAP:$KEYS]:-${_tab_link_fallback[main:$KEYS]}}
  [[ -n "$fallback" && "$fallback" != undefined-key ]] && zle "$fallback"
}

# Parses a `set` line: the text into REPLY, its seq, cursor and execute flag into
# _tab_link_set_seq, _tab_link_set_cursor and _tab_link_set_execute. Fails for
# any other line.
typeset -g _tab_link_set_seq="" _tab_link_set_cursor="" _tab_link_set_execute=""
_tab_link_parse_set() {
  local -a fields
  fields=("${(@ps:\t:)1}")
  [[ "${fields[1]}" == set ]] || return 1
  _tab_link_set_seq=${fields[2]} _tab_link_set_cursor=${fields[3]} _tab_link_set_execute=${fields[4]}
  _tab_link_unescape "${(pj:\t:)fields[5,-1]}"
}

# Undoes _tab_link_escape into REPLY, holding `\\` aside as NUL so `\\n` stays
# a backslash and an n
_tab_link_unescape() {
  REPLY=${1//\\\\/$'\0'}
  REPLY=${REPLY//\\t/$'\t'}
  REPLY=${REPLY//\\n/$'\n'}
  REPLY=${REPLY//$'\0'/\\}
}

# Sets the line from a `set` line; succeeds only if the line should run. Drops
# an insert computed for an older buffer, i.e. the user typed since.
_tab_link_apply() {
  _tab_link_parse_set "$1" || return 1
  [[ -z "$_tab_link_set_seq" || "$_tab_link_set_seq" == "$_tab_link_seq" ]] || return 1
  BUFFER=$REPLY
  CURSOR=$_tab_link_set_cursor
  # Report the new line now, at the next seq, so a following insert lines up
  _tab_link_report
  [[ "$_tab_link_set_execute" == 1 ]]
}

# The popup's top suggestion, which the `specs` inline strategy reads
typeset -g _tab_link_ghost_buffer="" _tab_link_ghost_suffix=""

# Stores the suggestion from a `ghost` line, and redraws the ghost text if the
# line still matches. Compares with the line last reported, as the push handler
# is not a widget and cannot read $BUFFER. Skips a line a history widget
# recalled: the plugin shows no ghost text for it, and running a widget here
# would change $LASTWIDGET, which up-line-or-beginning-search checks to continue.
_tab_link_set_ghost() {
  local -a fields
  fields=("${(@ps:\t:)1}")
  _tab_link_unescape "${fields[2]}"
  _tab_link_ghost_buffer=$REPLY
  _tab_link_unescape "${fields[3]}"
  _tab_link_ghost_suffix=$REPLY
  # shellcheck disable=SC2154
  [[ "$_tab_link_ghost_buffer" == "${_tab_link_sent#*$'\t'}" \
    && "$_tab_link_ghost_buffer" != "$_TAB_AUTOSUGGEST_CLEARED_BUFFER" \
    && " ${TAB_AUTOSUGGEST_STRATEGY[*]} " == *" specs "* ]] \
    && zle _tab_link_refresh_ghost
}

# Redraws the inline suggestions plugin's ghost text for the line. The plugin
# skips this widget (leading underscore): its wrapper puts the old ghost text
# back whenever the line did not change, which would hide a pushed suggestion.
_tab_link_refresh_ghost() {
  # shellcheck disable=SC2154
  (( ${+widgets[autosuggest-fetch]} )) || return
  zle autosuggest-clear
  (( ${#BUFFER} && ! ${+_TAB_AUTOSUGGEST_DISABLED} )) && zle autosuggest-fetch
}

# Handles a pushed line other than a buffer: ghost text or keys to bind. Fails
# for a buffer.
_tab_link_handle_push() {
  case "$1" in
    # Handled whatever the helpers return, so the key widget keeps waiting
    ghost$'\t'*) _tab_link_set_ghost "$1"; return 0 ;;
    bind|bind$'\t'*) _tab_link_bind "${(@)${(@ps:\t:)1}[2,-1]}"; return 0 ;;
    *) return 1 ;;
  esac
}

# Handles a line tabterm pushes while zsh is idle. Not a widget: zle makes any
# widget run from a -F handler the $LASTWIDGET, so a widget runs only when the
# line or ghost text changes. zle does not finish a line from a -F handler, so a
# pushed `execute` waits for the next key.
_tab_link_on_push() {
  local line
  if ! IFS= read -r -u "$1" line 2>/dev/null; then
    _tab_link_disconnect
    return
  fi
  _tab_link_handle_push "$line" || zle _tab_link_apply_push -- "$line"
}

# Sets the line from a pushed `set` line
_tab_link_apply_push() {
  _tab_link_apply "$1"
  _tab_link_refresh_ghost
  zle -R
}

# Names the key sequences tabterm knows, as tabterm's no_pty/session.rs
# names them
_tab_link_init_keys() {
  local -i code
  local letter
  # control+letter first, so the named keys win where they share a byte (^I, ^M)
  for code in {1..26}; do
    (( letter = code + 96 ))
    letter=${(#)letter}
    _tab_link_key_name[${(#)code}]=control+$letter
    _tab_link_key_name[$'\e'$letter]=option+$letter
  done
  _tab_link_key_name+=(
    $'\t' tab
    $'\e[Z' shift+tab
    $'\r' enter
    $'\e' esc
    $'\e[A' up
    $'\eOA' up
    $'\e[B' down
    $'\eOB' down
    $'\e[C' right
    $'\eOC' right
    $'\e[D' left
    $'\eOD' left
    $'\e[H' home
    $'\eOH' home
    $'\e[F' end
    $'\eOF' end
    $'\e[5~' pageup
    $'\e[6~' pagedown
    $'\x7f' backspace
    $'\e[3~' delete
  )
}

# Binds the keys a `bind` line names, so pressing one asks tabterm, and gives
# every other key back the widget it had. Runs from the push handler, where a
# changed binding applies from the next key. Looks up each key's own widget only
# the first time, as that costs a process.
_tab_link_bind() {
  local -A want
  local name seq keymap binding
  local -a keymaps=(main emacs viins)
  for name in "$@"; do
    want[$name]=1
  done

  for name in "${(@k)_tab_link_bound}"; do
    (( ${+want[$name]} )) && continue
    for seq in "${(@k)_tab_link_key_name[(R)$name]}"; do
      for keymap in "${keymaps[@]}"; do
        binding=${_tab_link_fallback[$keymap:$seq]}
        if [[ -z "$binding" ]]; then
          continue
        elif [[ "$binding" == undefined-key ]]; then
          bindkey -M "$keymap" -r -- "$seq"
        else
          bindkey -M "$keymap" -- "$seq" "$binding"
        fi
      done
    done
    unset "_tab_link_bound[$name]"
  done

  for name in "${(@k)want}"; do
    (( ${+_tab_link_bound[$name]} )) && continue
    for seq in "${(@k)_tab_link_key_name[(R)$name]}"; do
      for keymap in "${keymaps[@]}"; do
        if (( ! ${+_tab_link_fallback[$keymap:$seq]} )); then
          binding=${${(z)$(bindkey -M "$keymap" -- "$seq" 2>/dev/null)}[2]}
          # Already ours: this keymap is main, which was just bound
          [[ "$binding" == tab-link-key ]] && binding=""
          _tab_link_fallback[$keymap:$seq]=$binding
        fi
        [[ -n "${_tab_link_fallback[$keymap:$seq]}" ]] && bindkey -M "$keymap" -- "$seq" tab-link-key
      done
    done
    _tab_link_bound[$name]=1
  done
}

# Binds the popup's keys again when this file is sourced again: .zshrc can
# rebind a key and drop ours, and tabterm sends `bind` only when the keys
# change. Forgets the widget a key had where the key is not ours now, so the
# key gives back the user's new widget. A keymap that was main ('') gets main's
# widget, as main can be another keymap now (e.g. after `bindkey -v`). Looks up
# all the keys in one process.
_tab_link_rebind() {
  local -a names=("${(@k)_tab_link_bound}") entries=("${(@k)_tab_link_fallback}") lines
  local -A old=("${(@kv)_tab_link_fallback}")
  local -i i
  local entry binding
  (( ${#names} )) || return 0
  # One line per entry, x where bindkey fails, so the lines stay in step
  lines=("${(@f)$(for entry in "${entries[@]}"; do
    bindkey -M "${entry%%:*}" -- "${entry#*:}" 2>/dev/null || print x
  done)}")
  for (( i = 1; i <= ${#entries}; i++ )); do
    entry=${entries[i]}
    binding=${${(z)lines[i]}[2]}
    if [[ "$binding" != tab-link-key ]]; then
      unset "_tab_link_fallback[$entry]"
    elif [[ -z "${old[$entry]}" ]]; then
      _tab_link_fallback[$entry]=${old[main:${entry#*:}]}
    fi
  done
  _tab_link_bound=()
  _tab_link_bind "${names[@]}"
}

# Focus reports, bound in every keymap so they never insert text
_tab_link_bind_focus() {
  local keymap
  for keymap in main emacs viins vicmd; do
    bindkey -M "$keymap" -- $'\e[O' _tab_link_focus_out
    bindkey -M "$keymap" -- $'\e[I' _tab_link_focus_in
  done
}

if _tab_link_active; then
  # No leading underscore, so the inline suggestions plugin wraps the key widget
  # and refreshes its ghost text when it changes the line. The push widgets
  # have one, so the plugin skips them; they refresh the ghost text themselves.
  zle -N tab-link-key _tab_link_key
  zle -N _tab_link_apply_push
  zle -N _tab_link_refresh_ghost
  zle -N _tab_link_focus_out
  zle -N _tab_link_focus_in
  autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-pre-redraw _tab_link_report
  add-zle-hook-widget line-init _tab_link_line_init
  # Its own hook: fig_preexec does nothing in no-PTY mode. add-zsh-hook adds
  # each hook once, so sourcing this file again adds no copy.
  autoload -Uz add-zsh-hook
  add-zsh-hook preexec _tab_link_preexec
  add-zsh-hook zshexit _tab_link_focus_off
  # The popup's keys are bound when tabterm sends them, once connected
  _tab_link_init_keys
  _tab_link_rebind
  _tab_link_bind_focus
fi

fi
