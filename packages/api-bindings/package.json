{
  "name": "@tab/api-bindings",
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "author": "Caleb Brown",
  "contributors": [
    "Amazon Web Services (https://github.com/aws/amazon-q-developer-cli)"
  ],
  "repository": "https://github.com/kayluhb/tab",
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "pnpm run clean && pnpm run generate-requests && tsc",
    "lint": "eslint src && prettier --check src",
    "lint:fix": "eslint --fix src && prettier --write src",
    "precommit": "lint-staged",
    "prepublishOnly": "pnpm run build",
    "generate-requests": "tsx codegen/generate-requests.ts && prettier -w src/requests.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.4.0",
    "@tab/proto": "workspace:^"
  },
  "devDependencies": {
    "@tab/eslint-config": "workspace:^",
    "@tab/tsconfig": "workspace:^",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "ts-morph": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "npx eslint --cache --fix"
  }
}
