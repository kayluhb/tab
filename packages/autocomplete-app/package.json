{
  "name": "@tab/autocomplete-app",
  "private": true,
  "version": "1.0.0",
  "repository": "https://github.com/kayluhb/tab",
  "type": "module",
  "exports": {
    "./fig.json": "./src/fig.json"
  },
  "scripts": {
    "set-host": "fig settings developer.autocomplete.host http://localhost:3124",
    "remove-host": "fig settings developer.autocomplete.host --delete",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 3124",
    "test": "vitest",
    "lint": "eslint src --report-unused-disable-directives && prettier --check src",
    "lint:fix": "eslint src --fix && prettier --write src",
    "clean": "rm -rf dist"
  },
  "browserslist": [
    "defaults",
    "Safari >= 11"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.4.0",
    "@fig/autocomplete-shared": "^1.1.2",
    "@juggle/resize-observer": "^3.4.0",
    "@tab/api-bindings": "workspace:~",
    "@tab/api-bindings-wrappers": "workspace:^",
    "@tab/autocomplete-parser": "workspace:^",
    "@tab/proto": "workspace:^",
    "@tab/shell-parser": "workspace:^",
    "deep-object-diff": "^1.1.9",
    "loglevel": "^1.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "tailwind-merge": "^3.7.0",
    "use-resize-observer": "^9.1.0",
    "util": "^0.12.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tab/eslint-config": "workspace:^",
    "@tab/fuzzysort": "workspace:^",
    "@tab/shared": "workspace:^",
    "@tab/tsconfig": "workspace:^",
    "@tab/types": "workspace:^",
    "@tab/vite-config": "workspace:^",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@withfig/autocomplete-types": "^1.31.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "bundledDependencies": [
    "@tab/fuzzysort",
    "@tab/shared"
  ]
}
